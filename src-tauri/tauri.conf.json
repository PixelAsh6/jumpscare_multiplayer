{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jumpscare Multiplayer",
  "version": "1.0.1",
  "identifier": "com.pixelash.jumpscare-multiplayer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jumpscare Multiplayer",
        "width": 700,
        "height": 950,
        "minWidth": 520,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: blob: data:; media-src 'self' https: blob: data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https: wss:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
