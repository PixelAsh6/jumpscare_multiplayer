{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jumpscare Multiplayer",
  "version": "0.1.0",
  "identifier": "com.pixelash.jumpscare-multiplayer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jumpscare Multiplayer",
        "width": 700,
        "height": 950,
        "minWidth": 520,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
